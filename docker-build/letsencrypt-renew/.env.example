# Copy to /opt/letsencrypt-renew/.env on the production EC2 host (mode 0600, root-owned).
# Reuse the same SMTP credentials the application uses for transactional email.
# Do NOT commit the populated .env file.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

ALERT_FROM=noreply@chatcraft.cc
ALERT_TO=adeomoboya@googlemail.com
